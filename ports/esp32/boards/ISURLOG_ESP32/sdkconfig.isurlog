# ISURLOG board delta on top of boards/sdkconfig.base + boards/sdkconfig.ble.
# 8MB flash with an OTA-capable partition table (dual app slot + larger vfs),
# instead of the stock 4MB single-slot layout.

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/ISURLOG_ESP32/partitions-8MiB-ota.csv"
